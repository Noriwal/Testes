# Copie para .env apenas se desejar uma configuração manual. O instalador gera
# automaticamente todas as senhas e chaves marcadas como CHANGE_ME.
COMPOSE_PROJECT_NAME=automation
TZ=America/Sao_Paulo

EVOLUTION_DOMAIN=evolution.localhost
N8N_DOMAIN=n8n.localhost
PUBLIC_SCHEME=http
HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_PORT=8080
LETSENCRYPT_EMAIL=admin@example.com

EVOLUTION_VERSION=v2.3.6
N8N_VERSION=2.1.4
POSTGRES_VERSION=16.6-alpine
REDIS_VERSION=7.4.2-alpine

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
EVOLUTION_DB=evolution_db
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=CHANGE_ME
N8N_DB=n8n_db
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME

EVOLUTION_API_KEY=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME

# false = execução regular; true = queue mode e worker dedicado.
ENABLE_N8N_WORKER=false
N8N_EXECUTIONS_MODE=regular
N8N_WORKER_CONCURRENCY=5
N8N_SECURE_COOKIE=false

EVOLUTION_CPUS=1.0
EVOLUTION_MEMORY=1024M
N8N_CPUS=1.5
N8N_MEMORY=1536M
N8N_WORKER_CPUS=1.0
N8N_WORKER_MEMORY=1024M
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=1024M
REDIS_CPUS=0.5
REDIS_MEMORY=512M

# BACKUP_DIR=/caminho/absoluto/para/backups
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_MONTHLY_RETENTION=6

